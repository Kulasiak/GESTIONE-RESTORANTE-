# Copia in .env.local e inserisci i valori del tuo progetto Supabase
# (Supabase → Project Settings → API). Senza queste variabili l'app
# funziona in modalita locale: tutto sul telefono, niente gruppo condiviso.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
# Notifiche ad app chiusa (facoltativo): chiave pubblica VAPID, vedi README
VITE_VAPID_PUBLIC_KEY=
